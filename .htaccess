RewriteEngine On

# Serve existing files and directories exactly as generated by Next export.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Support clean URLs for exported Next.js pages.
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Fallback to the exported home page for unknown client-side routes.
RewriteRule ^ index.html [L]
